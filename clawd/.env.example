# Composio — AI tool integrations (Gmail, Slack, GitHub, etc.)
COMPOSIO_API_KEY=

# Agency CRM MCP server
AGENCY_API_KEY=

# WhatsApp allowlists (comma-separated JIDs)
WHATSAPP_ALLOWED_DMS=
WHATSAPP_ALLOWED_GROUPS=

# Unipile — LinkedIn messaging (get credentials from https://app.unipile.com)
UNIPILE_BASE_URL=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=

# Heartbeat — periodic silent agent check-in (enabled by default, set to false to disable)
HEARTBEAT_ENABLED=true

# Handoff Server — human-in-the-loop approvals for sensitive actions
HANDOFF_BASE_URL=http://localhost:8080
HANDOFF_API_KEY=
HANDOFF_LOOP_ID=

# Obsidian Headless Sync (optional — syncs agent memory to Obsidian cloud)
OBSIDIAN_AUTH_TOKEN=
OBSIDIAN_VAULT_NAME=
